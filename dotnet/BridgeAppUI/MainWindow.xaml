<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BridgeAppUI.MainWindow" Title="Bridge Optimization Lab" Width="1400" Height="800" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Górny pasek zakładek -->
        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#111111" BorderBrush="#090909" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="12,0,0,0" VerticalAlignment="Stretch" KeyboardNavigation.TabIndex="1"/>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource AppBackgroundBrush}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#B8B8B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter x:Name="HeaderContent" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>

                                <Border x:Name="SelectionLine" Height="3" Margin="0,0,0,0" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#1B1B1B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#202020"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="SelectionLine" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Prosty placeholder dla zakładek, których jeszcze nie budujemy -->
        <Style x:Key="PlaceholderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Input Builder property editor -->
        <Style x:Key="PropertyNameText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PropertyUnitText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="PropertyMiniLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="1,0,0,3"/>
        </Style>

        <Style x:Key="PropertyBlock" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PropertyModeTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="ModeBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PropertyModeTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PropertyModeTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#262626" CornerRadius="4" HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                            </Border>

                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="0,7,0,0" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <TabControl Style="{StaticResource MainTabControlStyle}" SelectedIndex="0">

            <!-- ========================================================= -->
            <!-- INPUT BUILDER -->
            <!-- ========================================================= -->
            <TabItem Header="INPUT BUILDER" Style="{StaticResource MainTabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="124"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <!-- Ribbon zakładki Input Builder -->
                    <Border Style="{StaticResource TileBorder}" MinWidth="320">
    <StackPanel>
        <TextBlock Text="INPUT GENERATION"
                   Style="{StaticResource SectionHeaderText}"/>

        <StackPanel Orientation="Horizontal">

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Number of models"
                           Style="{StaticResource InspectorLabel}"/>

                <TextBox x:Name="NumberOfModelsTextBox"
                         Text="1000000"
                         Width="110"
                         Style="{StaticResource RibbonTextBox}"/>
            </StackPanel>

            <Button x:Name="GenerateInputFileButton"
                    Content="GENERATE"
                    Style="{StaticResource PrimaryButton}"
                    Height="40"
                    MinHeight="40"
                    VerticalAlignment="Bottom"
                    Click="GenerateInputFile_Click"/>

        </StackPanel>
    </StackPanel>
</Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InspectorPanel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="INPUT PROPERTIES" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <!-- GEOMETRY -->
                                    <Border Style="{StaticResource InspectorCard}">
                                        <StackPanel>
                                            <TextBlock Text="GEOMETRY" Style="{StaticResource SectionHeaderText}"/>

                                            <Border Style="{StaticResource PropertyBlock}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Number of spans" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[-]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
                                                    <TabControl Style="{StaticResource PropertyModeTabControl}" SelectedIndex="1" x:Name="NSpansModeTab">
                                                        <TabItem Header="Fixed">
                                                            <TextBox Text="2" Style="{StaticResource InspectorTextBox}" x:Name="NSpansFixedTextBox"/>
                                                        </TabItem>
                                                        <TabItem Header="Random">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="From" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="2" Style="{StaticResource InspectorTextBox}" x:Name="NSpansFromTextBox"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="To" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="10" Style="{StaticResource InspectorTextBox}" x:Name="NSpansToTextBox"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource PropertyBlock}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Span length" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[m]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
                                                    <TabControl Style="{StaticResource PropertyModeTabControl}" SelectedIndex="1" x:Name="SpanLengthModeTab">
                                                        <TabItem Header="Fixed">
                                                            <TextBox Text="20.0" Style="{StaticResource InspectorTextBox}" x:Name="SpanLengthFixedTextBox"/>
                                                        </TabItem>
                                                        <TabItem Header="Random">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="From" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="8.0" Style="{StaticResource InspectorTextBox}" x:Name="SpanLengthFromTextBox"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="To" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="30.0" Style="{StaticResource InspectorTextBox}" x:Name="SpanLengthToTextBox"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource PropertyBlock}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Beam height" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[m]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
                                                    <TabControl Style="{StaticResource PropertyModeTabControl}" SelectedIndex="1" x:Name="BeamHeightModeTab">
                                                        <TabItem Header="Fixed">
                                                            <TextBox Text="1.0" Style="{StaticResource InspectorTextBox}" x:Name="BeamHeightFixedTextBox"/>
                                                        </TabItem>
                                                        <TabItem Header="Random">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="From" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="0.75" Style="{StaticResource InspectorTextBox}" x:Name="BeamHeightFromTextBox"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="To" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="2.0" Style="{StaticResource InspectorTextBox}" x:Name="BeamHeightToTextBox"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>

                                            <Border BorderThickness="0">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Beam width" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[m]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
                                                    <TabControl Style="{StaticResource PropertyModeTabControl}" SelectedIndex="1" x:Name="BeamWidthModeTab">
                                                        <TabItem Header="Fixed">
                                                            <TextBox Text="0.5" Style="{StaticResource InspectorTextBox}" x:Name="BeamWidthFixedTextBox"/>
                                                        </TabItem>
                                                        <TabItem Header="Random">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="From" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="0.4" Style="{StaticResource InspectorTextBox}" x:Name="BeamWidthFromTextBox"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="To" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="1.2" Style="{StaticResource InspectorTextBox}" x:Name="BeamWidthToTextBox"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- LOADS -->
                                    <Border Style="{StaticResource InspectorCard}">
                                        <StackPanel>
                                            <TextBlock Text="LOADS" Style="{StaticResource SectionHeaderText}"/>

                                            <Border Style="{StaticResource PropertyBlock}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="UDL" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[kN/m]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
                                                    <TabControl Style="{StaticResource PropertyModeTabControl}" SelectedIndex="1" x:Name="UdlModeTab">
                                                        <TabItem Header="Fixed">
                                                            <TextBox Text="10.0" Style="{StaticResource InspectorTextBox}" x:Name="UdlFixedTextBox"/>
                                                        </TabItem>
                                                        <TabItem Header="Random">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="From" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="0.0" Style="{StaticResource InspectorTextBox}" x:Name="UdlFromTextBox"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="To" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="15.0" Style="{StaticResource InspectorTextBox}" x:Name="UdlToTextBox"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource PropertyBlock}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="UDL distribution" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[type]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
                                                    <TabControl Style="{StaticResource PropertyModeTabControl}" SelectedIndex="1" x:Name="UdlDistributionModeTab">
                                                        <TabItem Header="Fixed">
                                                            <ComboBox SelectedIndex="0" Style="{StaticResource InspectorComboBox}" x:Name="UdlDistributionFixedComboBox">
                                                                <ComboBoxItem Content="True UDL"/>
                                                                <ComboBoxItem Content="Random span UDL"/>
                                                                <ComboBoxItem Content="Random UDL"/>
                                                                <ComboBoxItem Content="Random span + random UDL"/>
                                                                <ComboBoxItem Content="Symmetric random span UDL"/>
                                                                <ComboBoxItem Content="Symmetric random UDL"/>
                                                            </ComboBox>
                                                        </TabItem>
                                                        <TabItem Header="Random">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="From type" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <ComboBox SelectedIndex="0" Style="{StaticResource InspectorComboBox}" x:Name="UdlDistributionFromComboBox">
                                                                        <ComboBoxItem Content="1 · True UDL"/>
                                                                        <ComboBoxItem Content="2 · Random span UDL"/>
                                                                        <ComboBoxItem Content="3 · Random UDL"/>
                                                                        <ComboBoxItem Content="4 · Span + random UDL"/>
                                                                        <ComboBoxItem Content="5 · Symmetric span UDL"/>
                                                                        <ComboBoxItem Content="6 · Symmetric UDL"/>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="To type" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <ComboBox SelectedIndex="3" Style="{StaticResource InspectorComboBox}" x:Name="UdlDistributionToComboBox">
                                                                        <ComboBoxItem Content="1 · True UDL"/>
                                                                        <ComboBoxItem Content="2 · Random span UDL"/>
                                                                        <ComboBoxItem Content="3 · Random UDL"/>
                                                                        <ComboBoxItem Content="4 · Span + random UDL"/>
                                                                        <ComboBoxItem Content="5 · Symmetric span UDL"/>
                                                                        <ComboBoxItem Content="6 · Symmetric UDL"/>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Self weight case" Style="{StaticResource PropertyMiniLabel}"/>
                                                    <TextBox Text="Self Weight" Style="{StaticResource InspectorTextBox}" x:Name="SelfWeightCaseTextBox"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="UDL case" Style="{StaticResource PropertyMiniLabel}"/>
                                                    <TextBox Text="UDL" Style="{StaticResource InspectorTextBox}" x:Name="UdlCaseTextBox"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Prestress case" Style="{StaticResource PropertyMiniLabel}" Margin="1,8,0,3"/>
                                            <TextBox Text="Prestress" Style="{StaticResource InspectorTextBox}" x:Name="PrestressCaseTextBox"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- SUPPORTS -->
                                    <Border Style="{StaticResource InspectorCard}">
                                        <StackPanel>
                                            <TextBlock Text="SUPPORTS" Style="{StaticResource SectionHeaderText}"/>
                                            <TextBlock Text="Left support" Style="{StaticResource PropertyMiniLabel}"/>
                                            <TextBox Text="111000" Style="{StaticResource InspectorTextBox}" Margin="0,0,0,8" x:Name="LeftSupportTextBox"/>
                                            <TextBlock Text="Internal support" Style="{StaticResource PropertyMiniLabel}"/>
                                            <TextBox Text="011000" Style="{StaticResource InspectorTextBox}" Margin="0,0,0,8" x:Name="InternalSupportTextBox"/>
                                            <TextBlock Text="Right support" Style="{StaticResource PropertyMiniLabel}"/>
                                            <TextBox Text="011000" Style="{StaticResource InspectorTextBox}" x:Name="RightSupportTextBox"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- TENDON -->
                                    <Border Style="{StaticResource InspectorCard}">
                                        <StackPanel>
                                            <TextBlock Text="TENDON" Style="{StaticResource SectionHeaderText}"/>

                                            <Border Style="{StaticResource PropertyBlock}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Number of tendons" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[-]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
                                                    <TabControl Style="{StaticResource PropertyModeTabControl}" SelectedIndex="1" x:Name="NTendonsModeTab">
                                                        <TabItem Header="Fixed">
                                                            <TextBox Text="3" Style="{StaticResource InspectorTextBox}" x:Name="NTendonsFixedTextBox"/>
                                                        </TabItem>
                                                        <TabItem Header="Random">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="From" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="1" Style="{StaticResource InspectorTextBox}" x:Name="NTendonsFromTextBox"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="To" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="5" Style="{StaticResource InspectorTextBox}" x:Name="NTendonsToTextBox"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource PropertyBlock}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Tendon force" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[kN / tendon]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
                                                    <TabControl Style="{StaticResource PropertyModeTabControl}" SelectedIndex="0" x:Name="TendonForceModeTab">
                                                        <TabItem Header="Fixed">
                                                            <TextBox Text="220.0" Style="{StaticResource InspectorTextBox}" x:Name="TendonForceFixedTextBox"/>
                                                        </TabItem>
                                                        <TabItem Header="Random">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="From" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="180.0" Style="{StaticResource InspectorTextBox}" x:Name="TendonForceFromTextBox"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="To" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="260.0" Style="{StaticResource InspectorTextBox}" x:Name="TendonForceToTextBox"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource PropertyBlock}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Tendon area" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[mm² / tendon]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
                                                    <TabControl Style="{StaticResource PropertyModeTabControl}" SelectedIndex="0" x:Name="TendonAreaModeTab">
                                                        <TabItem Header="Fixed">
                                                            <TextBox Text="150.0" Style="{StaticResource InspectorTextBox}" x:Name="TendonAreaFixedTextBox"/>
                                                        </TabItem>
                                                        <TabItem Header="Random">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="From" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="100.0" Style="{StaticResource InspectorTextBox}" x:Name="TendonAreaFromTextBox"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="To" Style="{StaticResource PropertyMiniLabel}"/>
                                                                    <TextBox Text="200.0" Style="{StaticResource InspectorTextBox}" x:Name="TendonAreaToTextBox"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource PropertyBlock}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Tendon cover" Style="{StaticResource PropertyNameText}"/>
                                                        <TextBlock Grid.Column="1" Text="[m]" Style="{StaticResource PropertyUnitText}"/>
                                                    </Grid>
